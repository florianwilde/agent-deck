# Kopieren nach .env und anpassen. .env nie committen.

# capture = Phase 0 (speichert rohe Hook-Payloads), normal = ab Phase 1.
HUB_MODE=normal

# Bearer-Token für die öffentlichen Endpunkte (POST /events), mindestens 32 Zeichen.
# Erzeugen mit: openssl rand -hex 32
# Derselbe Wert kommt als Network Secret in die Claude-Cloud-Umgebung.
HUB_TOKEN=bitte-ersetzen-durch-openssl-rand-hex-32

# Bearer-Token für die VPN-Endpunkte (GET /state, WS /ws, POST /sessions/:id/ack), nur Normalbetrieb.
# Eigener Wert, nicht derselbe wie HUB_TOKEN. Kommt in die Einstellungen des Stream-Deck-Plugins.
HUB_VPN_TOKEN=bitte-ersetzen-durch-ein-zweites-openssl-rand-hex-32

# Host-Port, auf dem docker compose den öffentlichen Listener veröffentlicht (Ziel für den Reverse Proxy).
HUB_PUBLISH_PORT=8787

# Adresse und Port, an die docker compose den VPN-Listener bindet. Eine IP, die aus dem VPN
# erreichbar ist (NetBird- oder LAN-IP des Docker-Hosts), aber NICHT das Ziel des Reverse Proxys.
HUB_VPN_BIND=127.0.0.1
HUB_VPN_PUBLISH_PORT=8788

# Max. Requests pro Minute und IP auf POST /events.
HUB_RATE_LIMIT=60

# Nur Capture-Modus: max. Request-Body in Bytes. Im Normalbetrieb gilt fest 4096.
# HUB_BODY_LIMIT=262144

# trace | debug | info | warn | error
HUB_LOG_LEVEL=info

# Nur für Betrieb ohne Docker (im Container fest gesetzt):
# HUB_HOST=0.0.0.0
# HUB_PORT=8787
# HUB_VPN_HOST=127.0.0.1
# HUB_VPN_PORT=8788
# HUB_DB_PATH=./data/agent-deck.db
